# GitHub personal access token used to read PR metadata/diffs
# and post inline review comments.
GITHUB_TOKEN=your_github_token_here

# --- LLM provider ---
# "ollama" = free, runs locally, no API key needed.
# "claude" = requires ANTHROPIC_API_KEY.
LLM_PROVIDER=ollama

# Used only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Used only when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional.
# LOG_LEVEL=INFO